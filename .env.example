# Chaves opcionais. Sem elas o app funciona igual — só não oferece a busca
# automática de link do YouTube e de tom ao cadastrar uma sugestão.
# Em produção, entram como secrets do repositório com estes mesmos nomes
# (o deploy já os repassa pro build).

# YouTube Data API v3 — console.cloud.google.com, no mesmo projeto do Firebase.
# Restrinja a chave ao domínio do site. Cota grátis dá ~100 buscas por dia.
VITE_YOUTUBE_API_KEY=

# GetSongBPM — getsongbpm.com/api. Exige um link de atribuição no site,
# que o app já mostra junto do tom sugerido.
VITE_GETSONGBPM_API_KEY=
